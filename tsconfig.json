{
  "compilerOptions": {
    "module": "commonjs",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "target": "es2019",
    "strict": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@vendure/dashboard/plugin": ["node_modules/@vendure/dashboard/dist/plugin/index.d.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "migration.ts",
    "src/plugins/**/ui/*",
    "src/plugins/**/dashboard/*",
    "src/gql/*",
    "admin-ui",
    "dist",
    "vite.*.*ts"
  ],
  "references": [
    {
      "path": "./tsconfig.dashboard.json"
    }
  ],
  "ts-node": {
    "files": true
  }
}
