{
  "name": "nix-store-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "cross-env NODE_ENV=development ts-node ./src/index.ts",
    "dev:worker": "cross-env NODE_ENV=development ts-node ./src/index-worker.ts",
    "dev:dashboard": "vite --host 0.0.0.0",
    "dev:server-dashboard": "cross-env NODE_ENV=development concurrently npm:dev:server npm:dev:dashboard",
    "dev": "cross-env NODE_ENV=development concurrently npm:dev:server npm:dev:worker npm:dev:dashboard",
    "start:server": "node ./dist/src/index.js",
    "start:worker": "node ./dist/src/index-worker.js",
    "start": "concurrently npm:start:*",
    "build": "yarn build:dashboard && cross-env NODE_ENV=production tsc",
    "build:dashboard": "vite build",
    "codegen": "graphql-codegen --config codegen.ts",
    "migration:generate": "ts-node migration.ts generate",
    "migration:run": "ts-node migration.ts run",
    "migration:revert": "ts-node migration.ts revert",
    "k6:resources": "docker compose run --rm k6 run resource-smoke.js",
    "k6:resources:local": "cross-env K6_BASE_URL=http://host.docker.internal:3000 docker compose run --rm k6 run resource-smoke.js",
    "docker:dev": "docker compose up --build --watch",
    "docker:dev:plain": "docker compose up --build",
    "docker:dev:down": "docker compose down -v",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down"
  },
  "dependencies": {
    "@as-integrations/express5": "^1.1.2",
    "@elastic/elasticsearch": "9.1.0",
    "@vendure-community/elasticsearch-plugin": "1.1.0",
    "@vendure/asset-server-plugin": "3.6.3",
    "@vendure/common": "3.6.3",
    "@vendure/core": "3.6.3",
    "@vendure/dashboard": "3.6.3",
    "@vendure/email-plugin": "3.6.3",
    "@vendure/harden-plugin": "3.6.3",
    "dotenv": "16.4.5",
    "pg": "8.13.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@vendure/cli": "3.6.3",
    "@vendure/create": "3.6.3",
    "concurrently": "9.0.1",
    "cross-env": "^7.0.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "5.8.2"
  }
}
